WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# LLM providers — fill in the key for the provider you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                   # Google AI Studio key — free tier at aistudio.google.com
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM routing (google = Gemini free tier | openai | anthropic | ollama)
LLM_DEFAULT_PROVIDER=google
LLM_DEFAULT_MODEL=gemini-2.0-flash
LLM_FAST_MODEL=gemini-2.0-flash-lite
LLM_TEMPERATURE=0.0

# Embedding
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Reranker (bge = local, no API key needed | cohere = Cohere API)
COHERE_API_KEY=
RERANKER_PROVIDER=bge
BGE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_RERANK_MODEL=rerank-english-v3.0

# Redis / job queue
REDIS_URL=redis://localhost:6379/0

# API auth
JWT_ALGORITHM=RS256
JWT_AUDIENCE=rag-api
JWT_ISSUER=https://your-auth-server.example.com
JWKS_URI=https://your-auth-server.example.com/.well-known/jwks.json

# Rate limits (requests/minute)
RATE_LIMIT_CHAT=30
RATE_LIMIT_INGEST=10

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=production-rag-pipeline

# Retrieval defaults
RETRIEVAL_TOP_K_CANDIDATES=200
RETRIEVAL_RRF_K=60
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_RERANK_TOP_N=50
RETRIEVAL_FINAL_TOP_K=12
RETRIEVAL_HYBRID_ALPHA=0.5

# RAPTOR
RAPTOR_ENABLED=true
RAPTOR_MAX_CLUSTER_SIZE=10
RAPTOR_UMAP_N_COMPONENTS=10
RAPTOR_UMAP_N_NEIGHBORS=15

# CRAG
CRAG_QUALITY_THRESHOLD=0.35
CRAG_MAX_HOPS=2

# Self-RAG
SELF_RAG_ENABLED=true
